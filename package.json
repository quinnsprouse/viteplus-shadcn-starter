{
  "name": "rodeo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build --logLevel error",
    "preview": "vp preview",
    "start": "node .output/server/index.mjs",
    "prepare": "node scripts/setup.mjs",
    "setup": "node scripts/setup.mjs",
    "setup:skills": "vp dlx skills@1.5.15 experimental_install",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run test:e2e -- --ui",
    "test:e2e:headed": "npm run test:e2e -- --headed",
    "test:e2e:install": "playwright install chromium",
    "test:template": "node scripts/test-template.mjs",
    "typecheck": "tsc -b",
    "knip": "knip",
    "check": "node scripts/run-verification.mjs verify:fast",
    "check:push": "node scripts/run-verification.mjs verify:push",
    "check:ci": "node scripts/run-verification.mjs verify:ci",
    "doctor": "react-doctor --verbose"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "calligraph": "^1.4.1",
    "clsx": "^2.1.1",
    "motion": "^13.2.0",
    "penflow": "^0.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@oxlint/plugins": "1.81.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "nitro": "^3.0.260610-beta",
    "react-doctor": "0.9.13",
    "typescript": "^7.0.2",
    "vite-plus": "0.3.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "5.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.12.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^24.11.0"
  },
  "packageManager": "npm@11.12.0"
}
